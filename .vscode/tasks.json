{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pipeline",
      "type": "shell",
      "command": "python run_pipeline.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dashboard",
      "type": "shell",
      "command": "python -m streamlit run dashboard/app.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "api",
      "type": "shell",
      "command": "python -m uvicorn src.api:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "python -m ruff check src dashboard",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
